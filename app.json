{
  "expo": {
    "name": "PasarWhere",
    "slug": "pasarwhere",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d4e5680c-b50b-4c53-a321-d51ffbe373a8"
    },
    "scheme": "pasarwhere",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f5f5f5",
    "primaryColor": "#2e7d32",
    "assetBundlePatterns": [
      "**/*"
    ],
    "locales": {
      "zh-Hans": "./locales/zh-Hans.json"
    },
    "ios": {
      "bundleIdentifier": "com.sfdye.pasarwhere",
      "buildNumber": "1",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/mark-white.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ]
      }
    },
    "android": {
      "package": "com.sfdye.pasarwhere",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2e7d32"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-background-task",
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/mark-white.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2e7d32",
          "dark": {
            "backgroundColor": "#1b5e20"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2e7d32"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used only to find pasars near you. Your location never leaves your device.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d4e5680c-b50b-4c53-a321-d51ffbe373a8"
      }
    },
    "owner": "sfdye"
  }
}
